# ── Database ──────────────────────────────────────────────────────────────────
# Postgres cloud deployed URL (like MongoDB Atlas):
DATABASE_URL="postgres://..."

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000
CLIENT_ORIGIN=http://localhost:5173     # Frontend URL

# ── JWT secrets
JWT_ACCESS_SECRET=<64-char hex>
JWT_REFRESH_SECRET=<64-char hex>

# ── Token TTLs ────────────────────────────────────────────────────────────────
ACCESS_TOKEN_TTL=30          # minutes
REFRESH_TOKEN_TTL_DAYS=7     # days
RESET_TOKEN_TTL_MINUTES=15   # minutes
OTP_TTL_MINUTES=10           # minutes — signup email verification code

# ── SMTP (required — Sendgrid) ─────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@email.com
SMTP_PASS=your-key
SMTP_FROM="Mazik-Global Pakistan <workmazik@gmail.com>"

# ── LLM (Groq) — powers Workplace English Coach + AI Conversation Practice ──────
# Without GROQ_API_KEY these features fall back to offline heuristics.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── LiveKit (Live Call) — powers the "Live Call" two-way voice mode only.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Bey  — unset means Live Call stays audio-only.
BEY_API_KEY=
# Optional
BEY_AVATAR_ID=

# ── TTS (Piper) — powers AI Conversation Practice's TTS playback ────────────────
# Without it, /api/conversation/tts returns 503 and the client falls back to native TTS.
TTS_VOICE_MODEL=

# ── Pronunciation Coach (US-95) / Accent Assessment (US-93, US-89) ──────────────────
# See lib/speech_config.py for every field this feeds and its default. Nothing in
# lib/recording_engine.py or the pronunciation/accent services hardcodes these values.

# STT (faster-whisper) — runs in-process against the uploaded recording
STT_MODEL_SIZE=base
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8

# Audio limits
AUDIO_SAMPLE_RATE=16000
MIN_RECORDING_SECONDS=0.5
MAX_RECORDING_SECONDS=120
PRONUNCIATION_MAX_UPLOAD_MB=15
ACCENT_MAX_UPLOAD_MB=25

# VAD (silero-vad)
VAD_SPEECH_THRESHOLD=0.5

# Silence / background-noise rejection
MIN_AVG_DBFS=-40.0
MIN_SNR_DB=6.0

# Pronunciation Coach (US-95)
WORD_CONFIDENCE_THRESHOLD=0.55
STRESS_ERROR_SENSITIVITY=0.4
DISFLUENCY_REPETITION_WINDOW_SECONDS=2.0
PRONUNCIATION_RETRY_LIMIT=0

# US-90 Local Accent Calibration hook (not built yet — accepted but not yet applied)
DEFAULT_ACCENT_PROFILE=neutral

# Accent Assessment (US-93)
PASSAGE_MIN_COVERAGE=0.85
PASSAGE_TRAILING_COVERAGE_WINDOW=0.15
MULTISYLLABIC_MIN_SYLLABLES=2
CLARITY_SKIPPED_MULTISYLLABIC_PENALTY_WEIGHT=1.5
RHYTHM_MAX_ACCEPTABLE_CV=2.0
INTONATION_IDEAL_RANGE_MIN_SEMITONES=3.0
INTONATION_IDEAL_RANGE_MAX_SEMITONES=12.0

# Multi-voice / interference heuristic (best-effort, not true diarization)
MULTI_VOICE_PITCH_JUMP_SEMITONES=20.0
MULTI_VOICE_MIN_VOICED_SEGMENTS=4
MULTI_VOICE_MIN_RUN_SECONDS=0.06

# Accent Profile & Improvement (US-89)
EXERCISE_BATCH_SIZE=6
